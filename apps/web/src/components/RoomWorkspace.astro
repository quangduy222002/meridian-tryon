---
/**
 * The Roomcraft workspace: toolbar, 2D plan editor, 3D view, catalogue and dialogs. Used by /room/ and by the
 * /studio/ import flow, which adds its own steps around it through the slots.
 */
interface Props {
  brand: string;
  tagline: string;
  heading: string;
  /** Free-form state hook for page CSS (e.g. which import step is showing). */
  stage?: string;
}
const { brand, tagline, heading, stage = 'workspace' } = Astro.props;
---

<div class="rc" id="app" data-pane="plan" data-stage={stage}>
  <h1 class="sr-only">{heading}</h1>
  <header class="top">
    <a class="brand" href="../">
      {brand}
      <span>{tagline}</span>
    </a>
    <div class="tools" role="toolbar" aria-label="Plan tools" aria-controls="plan">
      <div role="group" aria-label="Draw">
        <button type="button" data-tool="select" aria-pressed="true">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 3l14 8-6 1.5L10 19z"></path>
          </svg>
          <span>Select</span>
        </button>
        <button type="button" data-tool="wall" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 20V8h8V4h8M4 20h4"></path>
          </svg>
          <span>Wall</span>
        </button>
        <button type="button" data-tool="door" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 20h14M8 20V5h8v15M13 12h.5"></path>
          </svg>
          <span>Door</span>
        </button>
        <button type="button" data-tool="window" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5h14v14H5zM12 5v14M5 12h14"></path>
          </svg>
          <span>Window</span>
        </button>
      </div>
      <span role="separator" aria-orientation="vertical"></span>
      <button type="button" id="furnBtn" popovertarget="catalog" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3M3 11h18v6H3zM5 17v2M19 17v2"></path>
        </svg>
        <span>Furniture</span>
      </button>
      <span role="separator" aria-orientation="vertical"></span>
      <div role="group" aria-label="History">
        <button type="button" id="undoBtn" aria-label="Undo" title="Undo (Ctrl+Z)">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 14L4 9l5-5M4 9h10a6 6 0 0 1 0 12h-3"></path>
          </svg>
        </button>
        <button type="button" id="redoBtn" aria-label="Redo" title="Redo (Ctrl+Shift+Z)">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 14l5-5-5-5M20 9H10a6 6 0 0 0 0 12h3"></path>
          </svg>
        </button>
      </div>
    </div>
    <div class="actions">
      <slot name="actions" />
      <button type="button" id="newBtn" aria-label="New" title="New plan">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 3h8l4 4v14H6zM14 3v4h4M12 11v6M9 14h6"></path>
        </svg>
        <span>New</span>
      </button>
      <button type="button" id="styleBtn" aria-label="Design style" title="Choose the design style of the home">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.6-.8 1.6-1.6 0-1-.8-1.3-.8-2.2 0-.9.7-1.6 1.6-1.6H17a4 4 0 0 0 4-4C21 6.6 17 3 12 3zM7.5 12a1 1 0 1 0 0-.1M10 7.5a1 1 0 1 0 0-.1M14.5 7.5a1 1 0 1 0 0-.1"></path>
        </svg>
        <span>Style</span>
      </button>
      <button
        type="button"
        id="lightBtn"
        aria-label="Lighting"
        title="Light fittings, colour temperature and night view"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"></path>
        </svg>
        <span>Lighting</span>
      </button>
      <button type="button" id="estimateBtn" aria-label="Estimate" title="Areas and cost estimate">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 3h14v18H5zM8 7h8M8 11h2M12 11h2M8 15h2M12 15h4"></path>
        </svg>
        <span>Estimate</span>
      </button>
      <button
        type="button"
        id="exportBtn"
        aria-label="Export"
        title="Export the plan (DXF, SVG, PNG) or a picture of the 3D view"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14 3H6v18h12V7zM14 3v4h4M12 10v7M9 14l3 3 3-3"></path>
        </svg>
        <span>Export</span>
      </button>
      <button type="button" id="aiBtn" aria-label="Furnish with AI" title="Furnish a room with AI">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"></path>
        </svg>
        <span>AI</span>
      </button>
      <span class="share-wrap">
        <button type="button" id="shareBtn" class="primary" aria-label="Share" title="Share a link to this plan">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 15V3M8 7l4-4 4 4M5 12v8h14v-8"></path>
          </svg>
          <span>Share</span>
        </button>
        <span class="share-tip" role="status"></span>
      </span>
    </div>
  </header>

  <main class="panes">
    <section class="pane plan" aria-label="2D floor plan">
      <canvas
        id="plan"
        tabindex="0"
        aria-label="Floor plan editor. Select with click or tap; arrow keys move the selection, R rotates furniture, Delete removes it."
      ></canvas>
      <p class="hint" id="hint" aria-live="polite"></p>
      <div class="zoom" role="group" aria-label="Plan zoom">
        <button type="button" id="zoomIn" aria-label="Zoom in" title="Zoom in">
          +
        </button>
        <button type="button" id="zoomOut" aria-label="Zoom out" title="Zoom out">
          −
        </button>
        <button type="button" id="zoomFit" aria-label="Fit plan" title="Fit plan">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
          </svg>
        </button>
      </div>
      <aside class="inspector" id="inspector" aria-label="Selection" hidden></aside>
    </section>

    <section class="pane three" id="viewer" aria-label="3D view">
      <canvas id="gl" aria-label="3D view of the home"></canvas>
      <p class="loader" aria-hidden="true">
        <i></i>Building…
      </p>
      <div class="modes" role="group" aria-label="3D view mode" id="modes">
        <button type="button" data-view="orbit" aria-pressed="true">
          Orbit
        </button>
        <button type="button" data-view="dollhouse" aria-pressed="false">
          Dollhouse
        </button>
        <button type="button" data-view="walk" aria-pressed="false">
          Walk
        </button>
      </div>
      <p class="walk-hint" id="walkHint">
        Drag to look · WASD or arrows to walk · Shift to hurry · Esc to leave
      </p>
      <div class="joy" id="joy" aria-hidden="true">
        <i></i>
      </div>
      <div class="sun">
        <label for="hour">
          <span>Sun</span>
          <output id="hourOut"></output>
        </label>
        <input type="range" id="hour" min="6" max="23" step="0.25" value="15" />
        <label for="north">
          <span id="northLabel">Facing</span>
          <output id="northOut"></output>
        </label>
        <input type="range" id="north" min="0" max="345" step="15" value="0" />
      </div>
    </section>
  </main>

  <nav class="switch" aria-label="Show">
    <button type="button" data-show="plan" aria-pressed="true">
      2D plan
    </button>
    <button type="button" data-show="three" aria-pressed="false">
      3D
    </button>
  </nav>

  <dialog id="estimate" class="sheet" aria-labelledby="estTitle">
    <header>
      <h2 id="estTitle">Areas &amp; estimate</h2>
      <form method="dialog">
        <button aria-label="Close estimate">✕</button>
      </form>
    </header>
    <div id="estBody"></div>
    <p class="note">Indicative supply-and-fit prices in USD, for comparing options — not a quote.</p>
  </dialog>

  <dialog id="styleDlg" class="sheet" aria-labelledby="styleTitle">
    <header>
      <h2 id="styleTitle">Design style</h2>
      <form method="dialog">
        <button aria-label="Close">✕</button>
      </form>
    </header>
    <p>
      One style for the whole home: it sets the timber and metal, how furniture stands, the palette, and the floor and
      wall finish of each room. Rooms you finished by hand are reset to the style.
    </p>
    <div class="style-grid" id="styleGrid" role="group" aria-label="Styles"></div>
  </dialog>

  <dialog id="lightDlg" class="sheet small" aria-labelledby="lightTitle">
    <header>
      <h2 id="lightTitle">Lighting</h2>
      <form method="dialog">
        <button aria-label="Close">✕</button>
      </form>
    </header>
    <p>
      Light fittings work in 3D: they come on by themselves after dusk (drag the sun past 19:00), or switch them on
      here. Add fittings from Furniture → Lighting, or let Floorwise draw a lighting plan.
    </p>
    <div class="choices">
      <button type="button" id="lightsOn" aria-pressed="false">
        Lights on
      </button>
      <button type="button" id="lightsAuto" class="primary">
        Design the lighting
      </button>
    </div>
    <p class="note">Colour temperature</p>
    <div class="choices" role="group" aria-label="Colour temperature" id="kelvins">
      <button type="button" data-kelvin="2700" aria-pressed="false">
        2700 K · warm
      </button>
      <button type="button" data-kelvin="3000" aria-pressed="true">
        3000 K · soft white
      </button>
      <button type="button" data-kelvin="4000" aria-pressed="false">
        4000 K · neutral
      </button>
    </div>
    <p class="ai-status" id="lightStatus" aria-live="polite"></p>
  </dialog>

  <dialog id="exportDlg" class="sheet small" aria-labelledby="exportTitle">
    <header>
      <h2 id="exportTitle">Export</h2>
      <form method="dialog">
        <button aria-label="Close">✕</button>
      </form>
    </header>
    <div class="export-list" role="group" aria-label="Formats">
      <button type="button" data-export="dxf">
        <b>DXF</b>
        <span>
          For AutoCAD and other CAD programs: walls, doors, windows, rooms and furniture on layers, in millimetres.
        </span>
      </button>
      <button type="button" data-export="svg">
        <b>SVG</b>
        <span>The plan as a vector drawing with room areas and a scale bar.</span>
      </button>
      <button type="button" data-export="png">
        <b>PNG</b>
        <span>The same plan drawing as an image.</span>
      </button>
      <button type="button" data-export="view">
        <b>3D view</b>
        <span>A picture of the 3D view as it is now.</span>
      </button>
    </div>
    <p class="ai-status" id="exportStatus" aria-live="polite"></p>
  </dialog>

  <dialog id="aiDlg" class="sheet" aria-labelledby="aiTitle">
    <header>
      <h2 id="aiTitle">Furnish with AI</h2>
      <form method="dialog">
        <button aria-label="Close">✕</button>
      </form>
    </header>
    <form id="aiForm" class="ai-form">
      <label>
        Room<select id="aiRoom"></select>
      </label>
      <label>
        What should it be?
        <textarea
          id="aiPrompt"
          rows="3"
          required
          placeholder="e.g. “A calm bedroom for two with a small desk by the window.”"
        ></textarea>
      </label>
      <label>
        Style<select id="aiStyle"></select>
      </label>
      <label class="check">
        <input type="checkbox" id="aiReplace" checked /> Replace the furniture already in this room
      </label>
      <div class="choices">
        <button type="submit" class="primary" id="aiGo">
          Furnish
        </button>
        <button type="button" id="aiKeyBtn" aria-expanded="false" aria-controls="aiKeyBox">
          API key
        </button>
      </div>
    </form>
    <form id="aiKeyBox" class="ai-form" hidden>
      <label>
        Anthropic API key
        <input id="aiKeyIn" type="password" autocomplete="off" spellcheck="false" placeholder="sk-ant-…" />
      </label>
      <div class="choices">
        <button type="submit">Save key</button>
        <button type="button" id="aiKeyForget">
          Forget
        </button>
      </div>
      <p>The key stays in this browser and goes straight to Anthropic; usage is billed to it.</p>
    </form>
    <p class="ai-status" id="aiStatus" aria-live="polite"></p>
  </dialog>

  <dialog id="newDlg" class="sheet small" aria-labelledby="newTitle">
    <h2 id="newTitle">Start a new plan?</h2>
    <p>Your current plan is replaced; undo still brings it back.</p>
    <form method="dialog" class="choices">
      <button value="blank" class="primary">
        Blank plan
      </button>
      <button value="sample">Sample flat</button>
      <button value="">Cancel</button>
    </form>
  </dialog>

  <div popover id="catalog" class="catalog" role="dialog" aria-labelledby="catalogTitle">
    <header>
      <h2 id="catalogTitle">Furniture</h2>
      <button type="button" popovertarget="catalog" popovertargetaction="hide" aria-label="Close furniture">
        ✕
      </button>
    </header>
    <p>Pick an item, then click the plan to place it — it snaps against the nearest wall.</p>
    <div class="cat-grid" id="catGrid"></div>
  </div>
  <slot />
</div>
