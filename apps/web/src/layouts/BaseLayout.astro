---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/base.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  themeColor?: string;
  favicon?: string;
  bodyClass?: string;
}

const { title, description, image, themeColor = '#0b0a09', favicon = 'favicon.svg', bodyClass } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? new URL((await getImage({ src: image, format: 'jpeg', width: 1200 })).src, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}${favicon}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
